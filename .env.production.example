# ==============================================================
#  .env.production.example — plantilla del .env de producción
#  --------------------------------------------------------------
#  - Copiar a .env.production (ignorado por git) y completar.
#  - Se sube a dos destinos: el web root de PHP y
#    /opt/jquery-node-api/.env, con F640 root:www-data.
#  - No guardar credenciales reales en este archivo.
#  - SITE_BASE no va acá: se usa solo en el build local (.env).
# ==============================================================

# API Node — defaults si se omiten: 127.0.0.1:3200
# El 3100 lo usa javascript-node en el mismo VPS.
API_HOST=127.0.0.1
API_PORT=3200

# MySQL — lo leen PHP (src/services/) y Node (api/).
# OJO: en local el puerto es 3307 (docker); en el VPS va el puerto real.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=jquery_user
MYSQL_PASSWORD=
MYSQL_DATABASE=jquery_mis_plugins_spa
