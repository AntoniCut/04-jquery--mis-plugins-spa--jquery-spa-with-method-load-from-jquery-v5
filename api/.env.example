# Runtime del API Node de jquery.antonydev.tech
# Copiar a api/.env en local o a /opt/jquery-node-api/.env en producción.
# En pnpm dev manda el .env de la raíz (MySQL local en el 3307).
API_HOST=127.0.0.1
API_PORT=3200
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=jquery_user
MYSQL_PASSWORD=cambia_esta_clave
MYSQL_DATABASE=jquery_mis_plugins_spa
