# Puertos de partida de los servidores locales.
# Si el puerto está ocupado (otro proyecto), se prueba el siguiente: +1, +2, ... hasta 20 intentos.
DEV_SERVER_PORT=9876
PREVIEW_SERVER_PORT=8765

# Base pública del sitio. Vacío = raíz del dominio (sin subcarpeta).
# Subcarpeta: /ruta/sin/barra/final (ej. /mis-plugins-spa/mi-demo)
SITE_BASE=

# Watch de BrowserSync
CHOKIDAR_USEPOLLING=false
CHOKIDAR_INTERVAL=250

# MySQL local (Docker). El contenedor publica MYSQL_PORT en el host.
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=jquery_user
MYSQL_PASSWORD=
MYSQL_DATABASE=jquery_mis_plugins_spa
