{
    "compilerOptions": {
        "checkJs": true,
        "noImplicitAny": true,
        "strict": true,
        "module": "ESNext",
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "moduleResolution": "bundler"
    },
    "include": [
        "types",
        "src",
        "src/libs/jquery/**/cdn/*.min.js",
        "generate-markdown-shiki.js",
        "gulpfile.js",
        "server",
        "api"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
