{
    "compilerOptions": {
        "checkJs": true,
        "noImplicitAny": true,
        "strict": true,
        "module": "ESNext",
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "moduleResolution": "bundler"
    },
    "include": [
        "types",
        "src",
        "src/libs/jquery/**/cdn/*.min.js",
        "gulpfile.js",
        "spa.config.js",
        "spa.config.js.example",
        "packages/spa-server",
        "packages/spa-build",
        "packages/jq-spa-core",
        "api"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "src/scripts"
    ]
}
