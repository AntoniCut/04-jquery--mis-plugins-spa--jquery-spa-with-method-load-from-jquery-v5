/*
    *  -----------------------------------------------------------------------  *
    *  -----  spa.config.js.example  --  /spa.config.js.example  -----  *
    *  -----------------------------------------------------------------------  *
*/



/*
    Plantilla de spa.config.js para @antonydev/spa-build (SPEC 03).

    - Copia este archivo a spa.config.js y ajusta solo lo que tu sitio necesite.
    - Puertos, SITE_BASE y CHOKIDAR_* siguen en .env; no van aquí.
    - Rutas son relativas a la raíz del proyecto (donde corre pnpm / gulp).
    - Hasta el paso 4 de SPEC 03 el gulpfile.js sigue usando paths internos;
      este archivo ya fija el contrato que consumirá el paquete spa-build.
*/



//  -----  tipos del config de spa-build  -----
/// <reference path="./types/spa-build-config.d.js" />



/**
 * -------------------------
 * -----  `jqueryUiWidgets`  -----
 * -------------------------
 * - Lista explícita de módulos jquery-ui/ui que el build copia a app/libs.
 * - En SPEC 04 pasará al paquete jq-spa-core; hasta entonces se mantiene aquí.
 */
const jqueryUiWidgets = [
    'node_modules/jquery-ui/ui/version.js',
    'node_modules/jquery-ui/ui/widget.js',
    'node_modules/jquery-ui/ui/data.js',
    'node_modules/jquery-ui/ui/plugin.js',
    'node_modules/jquery-ui/ui/scroll-parent.js',
    'node_modules/jquery-ui/ui/keycode.js',
    'node_modules/jquery-ui/ui/position.js',
    'node_modules/jquery-ui/ui/unique-id.js',
    'node_modules/jquery-ui/ui/widgets/mouse.js',
    'node_modules/jquery-ui/ui/widgets/draggable.js',
    'node_modules/jquery-ui/ui/widgets/sortable.js',
    'node_modules/jquery-ui/ui/widgets/resizable.js',
    'node_modules/jquery-ui/ui/widgets/button.js',
    'node_modules/jquery-ui/ui/widgets/dialog.js',
    'node_modules/jquery-ui/ui/widgets/datepicker.js',
    'node_modules/jquery-ui/ui/widgets/tooltip.js',
];



/**
 * -----------------------------
 * -----  `spaBuildConfig`  -----
 * -----------------------------
 * @type {SpaBuildConfig}
 */
const spaBuildConfig = {

    //  -----  dirs: orígenes y carpetas de salida del pipeline  -----
    dirs: {
        src: 'src',
        app: 'app',
        dist: 'dist',
        markdownShiki: 'src/markdown-shiki',
        routes: 'src/routes',
    },

    //  -----  shiki: tema y escaneo de route-*.js para MarkdownShikiHtml  -----
    shiki: {
        theme: 'dark-plus',
        stripHeaderBanner: true,
        routeFilePattern: /^route-.*\.js$/,
        routeManifestFile: 'route-manifest.js',
    },

    //  -----  siteBase: canónico en spa-server, copia a app/config y reexport en src/config  -----
    siteBase: {
        packageFile: 'packages/spa-server/src/site-base.js',
        appConfigFile: 'app/config/site-base.js',
        srcReexportDir: 'src/config',
    },

    //  -----  root: shell y htaccess minificados a dist/ con %SITE_BASE% sustituido  -----
    root: {
        indexHtml: 'index.html',
        htaccess: '.htaccess',
    },

    //  -----  convertImages: png de capturas de clase convertidos a avif en build  -----
    convertImages: {
        pngGlob: 'src/assets/img/clase-*/*.png',
    },

    //  -----  vendor: jquery y widgets ui copiados desde node_modules  -----
    vendor: {
        jqueryModule: 'node_modules/jquery/dist-module/jquery.module.min.js',
        jqueryUiWidgets,
    },

    //  -----  framework: jq-spa-core (libs jquery y plugin SPA) hasta app/framework en paso 4  -----
    framework: {
        jqSpaCore: 'packages/jq-spa-core/src',
        jqSpaCoreApp: 'app/framework/jq-spa-core',
        spaLoadingEffect: 'packages/spa-loading-effect/src',
        spaLoadingEffectApp: 'app/framework/spa-loading-effect',
    },

    //  -----  extraCopy: globs adicionales src → app (vacío en el prototipo)  -----
    extraCopy: [],

};



//  -----  exportar el config como default  -----
export default spaBuildConfig;